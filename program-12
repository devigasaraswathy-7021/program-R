n <- as.integer(readline("Enter number of elements: "))

arr <- numeric(n)

for (i in 1:n) {
  arr[i] <- as.integer(readline(paste("Enter element", i, ": ")))
}

even <- 0
odd <- 0

for (i in arr) {
  if (i %% 2 == 0)
    even <- even + 1
  else
    odd <- odd + 1
}

cat("Even numbers count =", even, "\n")
cat("Odd numbers count =", odd)
