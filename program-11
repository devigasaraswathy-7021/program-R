factorial <- function(n) {
  if (n == 0 || n == 1) {
    return(1)
  } else {
    return(n * factorial(n - 1))
  }
}

num <- as.integer(readline("Enter a number: "))

if (num < 0) {
  cat("Factorial is not defined for negative numbers")
} else {
  result <- factorial(num)
  cat("Factorial of", num, "=", result)
}
